# Large Assets (tracked via manifest.json, not git)
assets/fonts/*.woff2
assets/fonts/*.ttf
assets/images/*.jpg
assets/images/*.png
assets/images/*.webp
assets/lottie/*.json
assets/sfx/*.wav
assets/sfx/*.mp3
assets/music/*.mp3
assets/vo/*.mp3
assets/vo/*.wav

# Keep directory structure but ignore contents
!assets/fonts/.gitkeep
!assets/images/.gitkeep
!assets/lottie/.gitkeep
!assets/sfx/.gitkeep
!assets/music/.gitkeep
!assets/vo/.gitkeep
!renders/previews/.gitkeep
!renders/final/.gitkeep
!cache/.gitkeep
!models/.gitkeep